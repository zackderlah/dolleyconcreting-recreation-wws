---
import { site } from "../lib/cms";

interface Props {
  current: string;
}

const { current } = Astro.props;
---

<section class="flex flex-wrap items-center gap-2 bg-nav px-4 py-2">
  <a href="/" class="mr-4 shrink-0">
    <img src={site.logo} alt="Dolley Concreting" class="h-12 w-auto" />
  </a>
  <nav class="flex flex-wrap items-center" aria-label="Primary">
    {site.nav.map((item) => (
      <a class="nav-link" href={item.href} aria-current={current === item.href ? "page" : undefined}>{item.label}</a>
    ))}
  </nav>
</section>
