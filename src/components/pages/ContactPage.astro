---
import { site } from "../../lib/cms";

const { page } = Astro.props;
---

<section class="bg-page px-4 py-12 text-ink">
  <div class="mx-auto flex max-w-5xl flex-col gap-10 md:flex-row">
    <div class="flex-1">
      <h1 class="text-3xl uppercase tracking-wide">{page.heading}</h1>
      <div class="mt-6 space-y-3 leading-7">
        {page.lines.map((line: string) => <p>{line}</p>)}
      </div>
      <p class="mt-4">
        <a class="underline" href={site.phoneHref}>{site.phone}</a><br />
        <a class="underline" href={site.officeHref}>{site.office}</a><br />
        <a class="underline" href={site.emailHref}>{site.email}</a>
      </p>
    </div>
    <form class="flex-1 space-y-4" method="post" action={site.emailHref}>
      {page.fields.map((field: { label: string; name: string; required: boolean }) => (
        <label class="block text-sm">
          {field.label}
          {field.name === "comments" ? (
            <textarea class="mt-1 h-28 w-full border border-neutral-300 bg-white px-3 py-2" name={field.name} required={field.required}></textarea>
          ) : (
            <input class="mt-1 w-full border border-neutral-300 bg-white px-3 py-2" name={field.name} required={field.required} />
          )}
        </label>
      ))}
      <button class="btn-red" type="submit">SUBMIT</button>
    </form>
  </div>
</section>
